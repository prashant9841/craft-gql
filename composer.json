	"description": "GraphQL operations and field schema for any entry: a CP page plus /gqlraw/<entryId>[/fields].",
	"type": "craft-plugin",
	"version": "1.0.0",
	"license": "proprietary",
	"require": {
		"php": ">=8.2",
		"craftcms/cms": "^5.0"
	},
	"autoload": {
		"psr-4": {
			"prashant\\gqldocs\\": "src/"
		}
	},
	"extra": {
		"handle": "gqldocs",
		"name": "GQL Docs",
		"class": "prashant\\gqldocs\\GqlDocs"
	}
}
